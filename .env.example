# SwarmRescue optional settings.
# Copy to .env (which git ignores) and edit if you want to change the defaults.
# SwarmRescue needs NO secrets or API keys. Never put credentials in this file.

# Base seed for the default missions (CLI --seeds default and dashboard seed).
# Integer from 0 to 10000. Default: 1 (runs seeds 1, 2, 3).
SWARM_SEED=1

# Logging verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL. Default: WARNING.
LOG_LEVEL=WARNING
